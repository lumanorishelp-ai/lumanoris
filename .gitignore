# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# NOTE: the actual app lives under web/ (Next.js) and api/ (PHP), not the repo root —
# patterns below are intentionally unanchored (no leading slash) so they match
# node_modules/.next/out/vendor no matter how deep they're nested (web/node_modules,
# api/admin/vendor, etc.), instead of only matching a root-level copy that doesn't exist.

# dependencies (JS)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# dependencies (PHP) — composer.lock stays tracked, only the generated vendor/ folder is ignored
vendor/

.history

# testing
coverage/

# next.js
.next/
# NEXT_DIST_DIR ile alınan doğrulama build'leri (dev sunucusunun .next'ini ezmesin)
.next-verify/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug / runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
error_log
*.log

# PHP local DB dumps / backups — never commit real or scratch data
db_backup/
*.sql
# storage/ tamamen ignore EDİLMİYOR: içindeki storage/.gitignore her şeyi
# ignore edip kendini bırakıyor, böylece temiz bir klonda dizin var oluyor ama
# içeriği (yedekler, loglar) asla commit'lenmiyor.
storage/*
!storage/.gitignore

# ARCH-003 / DB-002: şema ve migration'lar YAPILANDIRMA, döküm değil. Yukarıdaki
# *.sql kuralı bunları da yutuyordu; sonuç: temiz bir klonda kurulacak veritabanı
# yok, ve migration'lar (bir önceki denetimin ölçülmüş çıktısı) hiçbir yere
# ulaşmıyordu. Gerçek dökümler storage/ altında ve hâlâ ignore'lu.
!api/database/*.sql
!api/database/**/*.sql

# env files (can opt-in for committing if needed)
.env*
!.env.example
!*.env.example

# root-level credential/notes files — these held real secrets (Google OAuth client
# id/secret, server connection info) and must never be committed again
/google.txt
/customserver.txt
/chatbot_table.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.history/
.DS_Store

# 12 — uçtan uca doğrulama ekran görüntüleri (yerel; yalnızca rapor commit edilir)
docs/verification/2026-10/
