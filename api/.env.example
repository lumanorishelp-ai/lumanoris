# Set to "true" only in local development — shows real exception messages in
# API error responses. Leave unset/false in production (errors are still
# logged server-side via error_log either way).
APP_DEBUG=false

# ── Admin paneli hesabı ─────────────────────────────────────────────────
# ADMIN_USERNAME tanımlıysa admin girişi SADECE buradan doğrulanır; `adminler`
# tablosuna hiç bakılmaz ve panelin "Admin Yönetimi" ekranı salt-okunur olur.
# Böylece en yetkili hesap DB'ye yazabilen hiçbir yoldan oluşturulamaz.
# Satırı tamamen kaldırırsanız eski davranışa (adminler tablosu) dönülür.
#
# Şifre düz metin yazılır — hash üretmeye gerek yok:
ADMIN_USERNAME=admin
ADMIN_PASSWORD=buraya-sifrenizi-yazin
#
# İsteğe bağlı: .env dosyasını okuyabilen birinin şifreyi de görmesini
# istemiyorsanız düz metin yerine hash kullanabilirsiniz. Tanımlıysa
# ADMIN_PASSWORD yerine bu geçerli olur.
#   php -r "echo password_hash('parolaniz', PASSWORD_BCRYPT, ['cost'=>12]);"
# ADMIN_PASSWORD_HASH=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Note: the Google Gemini key used for chat responses (API_GOOGLE_GEMINI) is
# NOT read from this file — it's managed separately in api/admin/.env via the
# admin panel's "API Ayarları" page (admin/api.php), read server-side only by
# ChatController::generateReply. Never sent to the client.

# Email
CONTACT_EMAIL=admin@example.com
NOREPLY_EMAIL=no-reply@example.com

# Param POS (ödeme sistemi)
PARAM_RECONCILE_SECRET=your-secret-key

# Veritabanı — DÖRDÜ DE ZORUNLU. Eksikse uygulama bağlanmak yerine hata verir
# (SEC-008: eskiden db.php içinde hard-coded dev değerlerine düşüyordu).
# Parolasız bir kullanıcı için DB_PASS= satırını boş bırakın.
DB_HOST=localhost:3306
DB_NAME=lumanoris
DB_USER=root
DB_PASS=

# Veritabanı yedeklerinin yazılacağı dizin. Varsayılan: repo kökündeki
# storage/db_backup (doküman kökünün DIŞINDA — bkz. SEC-001).
# DB_BACKUP_DIR=/var/backups/lumanoris

# ── iyzico (aktif ödeme sağlayıcısı) ─────────────────────────────────────
# Tahsilat, iade ve mutabakat bu anahtarlarla yapılıyor. TANIMSIZ BIRAKILIRSA
# hiçbir ödeme alınmaz (fail-closed) — checkout kullanıcıya "ödeme altyapısı
# kullanılamıyor" der ve sebep error_log'a düşer. Anahtarlar
# iyzico merchant panelinden alınır (Ayarlar → API anahtarları).
#
# IYZICO_BASE_URL:
#   sandbox → https://sandbox-api.iyzipay.com   (test kartlarıyla çalışır)
#   canlı   → https://api.iyzipay.com           (GERÇEK PARA ÇEKER)
# Varsayılan bilinçli olarak sandbox: yanlış yapılandırma sonucu canlı karta
# para düşmesindense test ortamına düşmesi yeğdir.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ── Ödeme sağlayıcısı seçimi (Faz 7a) ─────────────────────────────────────
# Üyelik paketi satın alma bu sağlayıcıdan geçer (Ortak Ödeme Sayfası; kart
# bilgisi Lumanoris'e hiç gelmez). Değerler: none | hoppa.
# Varsayılan none: paket ödemesi kapalı, kullanıcıya "Ödeme altyapısı
# hazırlanıyor" gösterilir. Pazaryeri satışı bu ayardan ETKİLENMEZ.
PAYMENT_PROVIDER=none

# ── Hoppa (EsnekPOS altyapısı) ───────────────────────────────────────────
# HOPPA_MODE: test (varsayılan) → https://posservicetest.esnekpos.com
#             live              → https://posservice.esnekpos.com (GERÇEK PARA)
# Yalnızca seçili moda ait MERCHANT/MERCHANT_KEY okunur; boşsa ödeme kapalı.
# Test için dokümandaki herkese açık test üye işyeri kullanılabilir
# (developer.esnekpos.com → Test Ortamı); değerleri buraya değil api/.env'e
# yazın. Canlı anahtarlar Hoppa'dan gelene kadar boş kalır.
HOPPA_MODE=test
HOPPA_TEST_MERCHANT=
HOPPA_TEST_MERCHANT_KEY=
HOPPA_LIVE_MERCHANT=
HOPPA_LIVE_MERCHANT_KEY=

# Sitenin dışarıdan erişilen adresi (sonda / yok). Hoppa ödeme sonucunu
# APP_PUBLIC_URL/api/wallet/hoppa_return.php adresine döndürür. İstek
# başlığından türetilmez (Host başlığı sahtelenebilir). Canlı modda https
# zorunlu; tanımsızsa ödeme başlatılmaz.
APP_PUBLIC_URL=

# Yalnızca `php api/database/hoppa_selftest.php --e2e` için: playwright-core
# içeren node_modules dizini ve (isteğe bağlı) Chrome/Chromium yolu.
# HOPPA_E2E_NODE_PATH=
# HOPPA_E2E_CHROME=

# Param POS kimlik bilgileri — ARTIK KULLANILMIYOR. Sağlayıcı iyzico'ya
# geçildi; bu değişkenleri hiçbir kod okumuyor. Şemadaki `param_*` tablo ve
# sütun adları geriye dönük uyumluluk için korunuyor (içlerinde canlı veri
# var), ama anlamları artık iyzico alanları.
PARAM_CLIENT_CODE=
PARAM_CLIENT_USERNAME=
PARAM_CLIENT_PASSWORD=
PARAM_GUID=
PARAM_MARKETPLACE_GUID=
PARAM_PAYMENT_WSDL=
PARAM_MARKETPLACE_WSDL=
PARAM_PAYMENT_SECURITY_TYPE=
PARAM_REF_URL=
PARAM_SUCCESS_URL=
PARAM_FAIL_URL=

# PAY-007: parampos_callback.php bu sır olmadan HİÇBİR bildirimi kabul etmez
# (fail-closed). Gateway tarafında da aynı değer tanımlanmalı.
PARAM_CALLBACK_SECRET=

# SMTP (DEP-003). Boş bırakılırsa admin panelindeki "SMTP Ayarları"
# sayfasından yönetilen global_vars satırları kullanılır.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_NAME=Lumanoris
# SMTP_ENCRYPTION=auto

# PHP hata logunun yazılacağı dosya. Varsayılan: repo kökündeki
# storage/logs/php-error.log (doküman kökünün DIŞINDA — SEC-001).
# APP_LOG_FILE=/var/log/lumanoris/php-error.log

# mysqldump / mysql ikililerinin dizini. PATH üzerinde değillerse zorunlu
# (Windows kurulumları ve çoğu paylaşımlı hosting bunları PATH'e eklemez).
# MYSQL_BIN_DIR=C:/Program Files/MySQL/MySQL Server 8.0/bin
